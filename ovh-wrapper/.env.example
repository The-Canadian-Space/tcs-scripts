# OVH Canada API credentials
#
# Retrieve from 1Password entry `OVH_API_TCS`, or create fresh at:
#   https://ca.api.ovh.com/createToken/
# with the ACL scopes documented at:
#   docs/infrastructure/ovh-api.md § Prerequisites
#
# After filling in: chmod 600 .env  (ubuntu-owned)

OVH_ENDPOINT=ovh-ca
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Optional — defaults hardcoded in wrapper.py (current TCS VPS)
# OVH_VPS_NAME=vps-934e59a6.vps.ovh.net
